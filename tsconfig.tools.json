{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./packages/renderer/src/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts"
  ]
}
