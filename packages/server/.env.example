HOST=127.0.0.1
PORT=3690
DATA_ROOT=./data
# Must be outside DATA_ROOT, with no overlap in either direction.
STATE_ROOT=./state
# Streaming upload limit, bytes (default 100 GiB); nginx leaves this to Bun.
MAX_UPLOAD_BYTES=107374182400
# Generate each independently: openssl rand -hex 32
TOKEN=
ADMIN_PASSWORD=
# Optional backups: initialize a dedicated encrypted restic repository first.
# Password file must be private, absolute, and outside DATA_ROOT and STATE_ROOT.
# BACKUP_REPOSITORY=s3:https://backup.example.com/private-bucket/halloween
# BACKUP_PASSWORD_FILE=/etc/halloween-backup/password
# BACKUP_RESTIC_BINARY=/usr/local/bin/restic
# See BACKUPS.md for backend credentials and filesystem permissions.
# Production reverse proxy:
# PUBLIC_ORIGIN=https://halloween.yxswy.com
# TRUST_PROXY=1
# SECURE_COOKIES=1
