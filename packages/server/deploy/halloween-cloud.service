# /etc/systemd/system/halloween-cloud.service
# 部署时：修改 TOKEN；确认 WorkingDirectory（服务器代码目录）与 DATA_ROOT；bun 路径用 `which bun`
# 然后: systemctl daemon-reload && systemctl enable --now halloween-cloud

[Unit]
Description=Halloween Cloud API
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/halloween-cloud-app
ExecStart=/usr/local/bin/bun run src/index.ts
Environment=PORT=3690
Environment=DATA_ROOT=/srv/halloween-cloud
Environment=TOKEN=CHANGE_ME
Environment=ADMIN_PASSWORD=CHANGE_ME_TOO
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
