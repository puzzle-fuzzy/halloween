# Run as a dedicated user. Deploy the repository and install its frozen lockfile
# dependencies in /srv/halloween-cloud-app before enabling.
# Encrypted backups (Trash/Backups pages) need restic on PATH and these three
# BACKUP_* vars; create the repo once with:
#   RESTIC_REPOSITORY=... RESTIC_PASSWORD_FILE=... restic init
[Unit]
Description=Halloween personal cloud API
After=network.target

[Service]
Type=simple
User=halloween
Group=halloween
WorkingDirectory=/srv/halloween-cloud-app/packages/server
ExecStart=/usr/local/bin/bun run src/index.ts
EnvironmentFile=/etc/halloween-cloud.env
Environment=HOST=127.0.0.1
Environment=PORT=3690
Environment=DATA_ROOT=/srv/halloween-cloud
Environment=STATE_ROOT=/var/lib/halloween-cloud
Environment=TRUST_PROXY=1
Environment=SECURE_COOKIES=1
Environment=PUBLIC_ORIGIN=https://halloween.yxswy.com
# restic repository for encrypted backups (local path or s3:/rest:/... backend)
Environment=BACKUP_REPOSITORY=/srv/halloween-backup-repo
Environment=BACKUP_PASSWORD_FILE=/etc/halloween/backup-password
Environment=BACKUP_RESTIC_BINARY=/usr/local/bin/restic
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/halloween-cloud /var/lib/halloween-cloud /srv/halloween-backup-repo
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
